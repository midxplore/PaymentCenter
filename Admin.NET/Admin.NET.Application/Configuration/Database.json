{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  // ★ 本项目只有 PostgreSQL 一种数据库形态，且连接串就写在这里（唯一来源）。
  //   不要再加 Database.Development.json / Sqlite 之类的「按环境切换」配置：
  //   环境不是 Development 时会静默落到另一份配置，表现为「能启动、但连的是另一个库」。
  //   注意：本文件随发布分发（csproj 里是 PreserveNewest），部署时需替换为生产连接串
  //   —— 环境变量覆盖不了 DbConnection（原因见 Web.Entry/appsettings.json 的说明）。
  //   详细参数见 SqlSugar 官网。
  "DbConnection": {
    "EnableConsoleSql": false, // 启用控制台打印SQL
    "ConnectionConfigs": [
      {
        "DbType": "PostgreSQL",
        "ConnectionString": "PORT=38539;DATABASE=payment;HOST=8.219.79.35;PASSWORD=langya1818;USER ID=langya",
        "DbSettings": {
          "EnableInitDb": true, // 启用库初始化
          "EnableInitView": true, // 启用视图初始化
          "EnableDiffLog": false, // 启用库表差异日志
          "EnableUnderLine": false, // 启用驼峰转下划线
          "EnableConnEncrypt": false // 启用数据库连接串加密
        },
        "TableSettings": {
          "EnableInitTable": true, // 启用表初始化 —— ★ 首次初始化完成后建议置 false，否则每次启动都会全表 CodeFirst，约 7-8 分钟
          "EnableIncreTable": false // 启用表增量更新（只更新贴了特性[IncreTable]的实体表）
        },
        "SeedSettings": {
          "EnableInitSeed": true, // 启用种子初始化 —— ★ 同上，首次初始化完成后建议置 false
          "EnableIncreSeed": false // 启用种子增量更新（只更新贴了特性[IncreSeed]的种子表）
        }
      }
    ]
  }
}
