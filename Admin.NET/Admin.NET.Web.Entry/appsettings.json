{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  // 扫描配置文件 json 文件夹（自动合并该文件夹里所有 json 文件）
  //
  // ★ 配置只改 Admin.NET.Application/Configuration/ 下的文件，**不要**再加「本地覆盖目录」。
  //   Admin.NET.Application.csproj 把 Configuration\**\* 复制到输出目录；其中
  //   App.*.json / HttpRemote.*.json 设了 CopyToPublishDirectory=Never（开发专用，不随发布分发）。
  //
  // 两个实测结论，改动前务必知悉：
  //   1) Furion 在默认配置源之后加载这些扫描目录，优先级高于环境变量与根 appsettings*.json，
  //      所以想覆盖 DbConnection 只能靠这些文件，用环境变量无效；
  //   2) Furion 读的是**输出目录（bin/<cfg>/）里的副本**，改完源文件必须重新 build。
  //
  // ★ 扫描列表**只在本文件定义一处**：appsettings.Development.json 故意不写该键。
  //   .NET 配置对**数组按下标合并**，两份写法不一致时会「靠副作用成立」，极难归因。
  "ConfigurationScanDirectories": [ "Configuration", "" ]
}
