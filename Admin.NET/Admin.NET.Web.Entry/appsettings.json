{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",

  // 扫描配置文件json文件夹（自动合并该文件夹里面所有json文件）
  //
  // 末尾的 ConfigurationLocal 是「机器本地覆盖目录」：用于在不改动含连接串的
  // Configuration/Database.Development.json 的前提下，按开发机切换数据库
  // （见 scripts/run-backend-pg.sh 与 ConfigurationLocal/LocalOverride.json）。
  //
  // 两个实测结论，改动前务必知悉：
  //   1) Furion 在默认配置源之后加载这些扫描目录，优先级高于环境变量与根 appsettings*.json，
  //      所以想覆盖 DbConnection 只能靠扫描目录，用环境变量无效；
  //   2) 扫描时按「文件名」去重，同名文件会被静默跳过 —— 覆盖文件必须用唯一文件名
  //      （不能叫 Database.json）。
  "ConfigurationScanDirectories": [ "Configuration", "", "ConfigurationLocal" ]
}
